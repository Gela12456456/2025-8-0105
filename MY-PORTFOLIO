
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
  }

body {
background-image: url("el nido.jpeg");
background-size: cover;
background-position: center;
height: 100vh;
}

/* HOME PAGE */

.hero {
height: 100vh;
background: rgba(0, 0, 0, 0.40);
}

nav {
height: 100px;
display: flex;
justify-content: space-between;
align-items: center;
padding: 90px;
}

.logo {
display: flex;
align-items: center;
gap: 10px;
}

.logo img {
width: 200px;
}

.logo h2 {
color: white;
font-size: 35px;
}

.nav-links a {
color: white;
text-decoration: none;
margin-left: 25px;
font-size: 15px;
}

.nav-links a:hover {
color: #20d0d7;
}

.content {
color: white;
margin-left: 80px;
margin-top: 170px;
}

.content h1 {
font-family: 'Playfair Display', serif;
font-size: 65px;
line-height: 1.1;
}

.content span {
color: #20d0d7;
font-family: 'Playfair Display', serif;
}

.content p {
width: 500px;
font-size: 18px;
line-height: 1.6;
margin-top: 20px;
}

.learn {
display: inline-block;
margin-top: 25px;
padding: 12px 25px;
color: white;
border: 1px solid white;
text-decoration: none;
transition: 0.3s;
}

.learn:hover {
background: #20d0d7;
color: black;
border-color: #20d0d7;
}



* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
  }

body {
background-image: url("el nido.jpeg");
background-size: cover;
background-position: center;
height: 100vh;
}



.login-page {
min-height: 100vh;
background-image: url("el nido.jpeg");
background-size: cover;
background-position: center;
display: flex;
justify-content: center;
align-items: center;
padding: 20px;
}



.login-box {
width: 400px;
padding: 40px;
background: rgba(0, 0, 0, 0.60);
border-radius: 10px;
text-align: center;
color: white;
}

.login-box h1 {
margin-bottom: 30px;
font-size: 40px;
font-family: 'Playfair Display', serif;
}

.login-box input {
width: 100%;
padding: 15px;
margin: 10px 0;
border: none;
border-radius: 5px;
font-family: 'Poppins', sans-serif;
}

.login-box button {
width: 100%;
padding: 15px;
margin-top: 15px;
border: none;
border-radius: 5px;
background: #20d0d7;
cursor: pointer;
font-weight: bold;
}

.login-box button:hover {
background: white;
}

.login-box p {
margin-top: 20px;
}

.login-box a {
color: #20d0d7;
text-decoration: none;
}

.back-home {
display: inline-block;
margin-top: 20px;
}



